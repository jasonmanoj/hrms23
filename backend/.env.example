NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms?schema=public

# Local dev: discrete host/port, no auth.
REDIS_HOST=localhost
REDIS_PORT=6379
# Managed Redis (Railway/Render/Upstash): set REDIS_URL instead and leave the above unused.
# Use rediss:// (not redis://) if the provider requires TLS.
# REDIS_URL=rediss://default:password@host:port
# REDIS_PASSWORD=
# REDIS_TLS=false

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

MAIL_FROM=no-reply@hrms.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

UPLOAD_DIR=./uploads
